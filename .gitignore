# Virtual environments
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Built knowledge-base index (shipped as release asset, never committed)
ckb/

# Pinned raw source bytes: keep the pin RECORD (*.meta.json) in git, ignore the bytes.
# Bytes live in the local cache and are re-fetchable + hash-verified from the meta.
corpus/raw/*
!corpus/raw/.gitkeep
!corpus/raw/*.meta.json

# Databases / local stores
*.sqlite
*.sqlite3
*.db

# Model / hub caches
.cache/
hf_cache/

# Secrets & local config
.env
*.local.yaml

# IDE / editor
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs & scratch
*.log
tmp/
scratch/

